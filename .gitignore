# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenv
.venv/
venv/
env/

# Env / secrets
.env
.env.local
*.secret

# DB / data
*.db
*.sqlite
*.sqlite3
backend/database/*.db
backend/database/chroma_db/
backend/database/dogfooding.json
# Recorded microphone audio from live sessions. Never commit this.
backend/database/captures/

# Real people's phone numbers. Never commit this.
backend/database/contacts.json

# Logs / runtime
backend/logs/**
!backend/logs/.gitkeep
*.log

# Audio scratch
*.wav
*.mp3
tools/_recordings/
# Your voice, recorded for tools/stt_bench.py. Local by nature — it is
# personal audio and it is only meaningful on the machine it was recorded on.
tools/_stt_corpus/

# Probe output artifacts — ephemeral, regenerated by re-running the probe
tools/canvas_chain_probe_output.json

# One-off investigation scripts and DB snapshots, kept out of the tree so
# tools/ shows only maintained utilities. See tools/_scratch/README.md —
# nothing in there is disposable-by-default, it just isn't repo history.
tools/_scratch/

# Piper voice models (download via tools/download_piper_voice.py)
backend/ai_modules/speech/piper_voices/*.onnx
backend/ai_modules/speech/piper_voices/*.onnx.json

# Vosk acoustic models (download via tools/download_vosk_model.py)
backend/ai_modules/speech/vosk_models/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/
GEMINI.md

# Local-only reference material — not for the repo
resources/
SG_CUBE_CODEBASE_SUMMARY.md

# opencode local config — not for the repo
.opencode/
AGENTS.md

# Build / dist
build/
dist/

# Chroma probes that create accidental DBs at nonexistent paths
temp_check*/
temp_dir*/
DB_*/
chroma_backup*/
certs/
yolov8n*.pt

# Session handoff for coding agents — local, like AGENTS.md
HANDOFF.md

# SG_CUBE environment template. Copy to .env and fill in.
# .env is git-ignored. .env.example is checked in.

# ── App ──
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8001

# ── Supabase (Phase 2) ──
# From Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
# From Supabase Dashboard → Project Settings → API → JWT Settings (legacy JWT secret)
SUPABASE_JWT_SECRET=your_jwt_secret

# ── Ollama (local intent classifier + embeddings) ──
# Must stay local: the Ollama Cloud catalog has no embedding models, so
# ChromaDB memory breaks if OLLAMA_URL is repointed. With Ollama not running
# at all, the verifier's secondary check fails closed and rejects every
# deep-checked tool — which from the outside looks exactly like the assistant
# mishearing you.
OLLAMA_URL=http://localhost:11434
# The local fast model — classification, verification, intent. Note the name:
# there is no OLLAMA_MODEL setting. An OLLAMA_MODEL line here is silently
# ignored (Settings uses extra="ignore"), which is why it used to look set.
FAST_MODEL=phi3

# ── OpenRouter — NOT IMPLEMENTED ──
# No backend code reads OPENROUTER_API_KEY or OPENROUTER_MODEL. Setting them
# does nothing, silently. Kept here only to record the intended direction
# (DeepSeek V3: strong JSON / tool-use, cheapest of the open-source frontier
# tier); wiring it up means adding a backend under ai_modules/llm/backends/.

# ── Gemini (current default) ──
# Get keys at https://aistudio.google.com/apikey
#
# The free tier is metered PER DAY, so a single key exhausts inside one
# session. llm/key_pool.py tries slots in order and parks an exhausted key
# until its quota resets rather than retrying it forever — but it can only
# rotate across the keys you actually give it. Fill slots 2 and 3 from
# separate Google accounts to get the headroom the pool was built for.
#
# Both the planner and (with STT_BACKEND=gemini) speech-to-text draw on this
# same pool, so one voice turn costs at least two requests against it.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# ── Speech-to-text ──
# "gemini" (default) or "whisper". Whisper is kept as a one-flip revert until
# the live gate in docs/superpowers/specs/2026-08-25-gemini-stt-consolidation-design.md
# section 7.1 passes.
STT_BACKEND=gemini

# faster-whisper model size. Only read when STT_BACKEND=whisper.
# NOTE: stt_manager actually reads WHISPER_MODEL_GPU / WHISPER_MODEL_CPU,
# selected by STT_PROFILE. This one is legacy and is silently ignored.
WHISPER_MODEL=small

# ── Microphone calibration — MEASURE, don't guess ──
# Both of these were hardcoded constants chosen against an assumed near-silent
# room, and both were wrong on real hardware. Run:
#
#     .venv\Scripts\python.exe tools\calibrate_mic.py
#
# in the room you will actually use, and paste what it prints.
#
# VAD_RMS_THRESHOLD gates which frames reach the Vosk recognizer. Keep it LOW.
# Raising it drops the quiet gaps BETWEEN words and splices loud fragments
# into a discontinuous stream, and Vosk then hallucinates the wake phrase out
# of ordinary speech — tests/test_barge_in_real_audio.py fails at 100 and up.
VAD_RMS_THRESHOLD=50
# CAPTURE_SILENCE_THRESHOLD decides when the user has STOPPED talking (800ms
# below it ends the capture). This one must sit ABOVE your room's noise floor.
# It is separate from VAD_RMS_THRESHOLD precisely because the two want
# opposite things; sharing one constant meant that on a real machine ZERO
# frames of 30s of silence fell below the gate, so every capture ran to the
# 10s hard cap. Leave unset to inherit VAD_RMS_THRESHOLD (old behaviour).
# CAPTURE_SILENCE_THRESHOLD=1500
#
# Windows tip, measured: "Audio enhancements = Voice Clarity" (Microsoft Voice
# Focus) cut a noisy room's floor 3.4x and was the difference between usable
# and not. Realtek "Device Default Effects" did the opposite — it gated speech
# down to rms ~29. If the mic seems deaf, try the other setting and re-measure.

# ── Phase C3: LiveKit optional voice pipeline ──
# VOICE_PIPELINE=local|livekit
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
